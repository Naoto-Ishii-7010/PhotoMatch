    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.4",
    "dotenv": "^17.4.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "jsdom": "^29.0.2",
    "prettier": "3.8.2",
    "prisma": "7.7.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.4"
