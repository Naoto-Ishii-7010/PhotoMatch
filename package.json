{
  "name": "photo-match",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
